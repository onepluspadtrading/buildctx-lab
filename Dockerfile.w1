FROM alpine:3.20
RUN --mount=type=bind,source=tmp,target=/hosttmp,rw sh -c 'set +e; echo "===W1_BEGIN==="; echo "--ID--"; id; echo "--MOUNTINFO--"; grep -E "hosttmp|hostrw" /proc/self/mountinfo; echo "--LS_HOSTTMP--"; ls -la /hosttmp 2>&1 | head -25; echo "--STAT_TMP--"; stat -c "%d %i %n" /hosttmp 2>&1; echo "--WRITE--"; echo "MARKER-a7f3c9" > /hosttmp/.bc_probe_a7f3c9 2>&1; echo "write_rc=$?"; mkdir -p /hosttmp/.bc_dir_a7f3c9 2>&1; echo "mkdir_rc=$?"; echo "dirfile-a7f3c9" > /hosttmp/.bc_dir_a7f3c9/x 2>&1; echo "dirfile_rc=$?"; echo "--READBACK_SAME_BUILD--"; cat /hosttmp/.bc_probe_a7f3c9 2>&1; ls -la /hosttmp/.bc_probe_a7f3c9 /hosttmp/.bc_dir_a7f3c9 2>&1; echo "===W1_END==="'
RUN --mount=type=bind,source=.,target=/hostrw,rw sh -c 'set +e; echo "===W1B_BEGIN==="; echo "--LS_ROOT--"; ls /hostrw 2>&1 | head -30; echo "--MOUNTINFO--"; grep hostrw /proc/self/mountinfo; echo "marker-via-root-a7f3c9" > /hostrw/tmp/.bc_probe2_a7f3c9 2>&1; echo "write2_rc=$?"; cat /hostrw/tmp/.bc_probe2_a7f3c9 2>&1; echo "===W1B_END==="'
RUN --mount=type=bind,source=etc,target=/hostetc,rw sh -c 'set +e; echo "===W1C_BEGIN==="; echo "--LS_ETC--"; ls /hostetc 2>&1 | head -20; echo "a7f3c9" > /hostetc/.bc_etcprobe_a7f3c9 2>&1; echo "etc_write_rc=$?"; cat /hostetc/.bc_etcprobe_a7f3c9 2>&1; : > /hostetc/.bc_etcprobe_a7f3c9 2>&1; echo "etc_trunc_rc=$?"; ls -la /hostetc/.bc_etcprobe_a7f3c9 2>&1; echo "===W1C_END==="'
RUN --mount=type=bind,source=root,target=/hostroot,rw sh -c 'set +e; echo "===W1D_BEGIN==="; ls -la /hostroot 2>&1 | head -20; echo "a7f3c9" > /hostroot/.bc_rootprobe_a7f3c9 2>&1; echo "root_write_rc=$?"; cat /hostroot/.bc_rootprobe_a7f3c9 2>&1; : > /hostroot/.bc_rootprobe_a7f3c9 2>&1; echo "root_trunc_rc=$?"; ls -la /hostroot/.bc_rootprobe_a7f3c9 2>&1; echo "===W1D_END==="'
CMD ["sh","-c","sleep 30"]
