FROM alpine:3.20 AS base
ONBUILD RUN --mount=type=bind,source=tmp,target=/hosttmp,rw sh -c 'set +e; echo "===ONB1_BEGIN==="; id; echo "--MOUNTINFO--"; grep " /hosttmp " /proc/self/mountinfo; echo "--LS--"; ls -la /hosttmp 2>&1 | head -12; echo "--WRITE--"; echo "onb1-a7f3c9" > /hosttmp/.bc_onb1_a7f3c9 2>&1; echo "onb1_rc=$?"; cat /hosttmp/.bc_onb1_a7f3c9 2>&1; mkdir -p /hosttmp/.bc_dir_onb_a7f3c9 2>&1; echo "mkdir_rc=$?"; echo "dirx-a7f3c9" > /hosttmp/.bc_dir_onb_a7f3c9/x 2>&1; echo "dirx_rc=$?"; ls -la /hosttmp/.bc_dir_onb_a7f3c9 2>&1; echo "===ONB1_END==="'
ONBUILD RUN --mount=type=bind,source=etc,target=/hostetc,rw sh -c 'set +e; echo "===ONB3_BEGIN==="; echo "--MOUNTINFO--"; grep " /hostetc " /proc/self/mountinfo; echo "--LS--"; ls /hostetc 2>&1 | head -12; echo "onb3-a7f3c9" > /hostetc/.bc_onb3_a7f3c9 2>&1; echo "onb3_rc=$?"; cat /hostetc/.bc_onb3_a7f3c9 2>&1; unlink /hostetc/.bc_onb3_a7f3c9 2>&1; echo "onb3_unlink_rc=$?"; ls -la /hostetc/.bc_onb3_a7f3c9 2>&1; echo "===ONB3_END==="'
ONBUILD RUN --mount=type=bind,source=root,target=/hostroot,rw sh -c 'set +e; echo "===ONB4_BEGIN==="; echo "--MOUNTINFO--"; grep " /hostroot " /proc/self/mountinfo; echo "--LS--"; ls -la /hostroot 2>&1 | head -12; echo "onb4-a7f3c9" > /hostroot/.bc_onb4_a7f3c9 2>&1; echo "onb4_rc=$?"; cat /hostroot/.bc_onb4_a7f3c9 2>&1; unlink /hostroot/.bc_onb4_a7f3c9 2>&1; echo "onb4_unlink_rc=$?"; ls -la /hostroot/.bc_onb4_a7f3c9 2>&1; echo "===ONB4_END==="'
FROM base
RUN sh -c 'echo "===TRIGGER_CHECK==="; id; cat /etc/hostname'
CMD ["sh","-c","sleep 30"]
