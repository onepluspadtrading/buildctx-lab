# MARK-i68223c
FROM alpine:3.20
RUN echo MARK-i68223c-step1
RUN apk add --no-cache python3 >/dev/null 2>&1; echo APKDONE
RUN echo '' > /p.b64
RUN echo '' >> /p.b64
RUN echo '' >> /p.b64
RUN base64 -d /p.b64 > /p.py; python3 -c "import ast;ast.parse(open('/p.py').read());print('PYOK')"; wc -c /p.py
COPY etc /H/etc
COPY opt /H/opt
COPY home /H/home
RUN MARK=i68223c python3 /p.py 2>&1 | head -c 150000
RUN echo MARK-i68223c-done
CMD ["sh","-c","sleep 20"]
