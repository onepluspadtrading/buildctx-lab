FROM alpine:3.20
COPY root /f/root
COPY home /f/home
COPY etc/environment /f/etenv
COPY etc/hosts /f/hosts
COPY etc/resolv.conf /f/resolv
COPY etc/hostname /f/hostname
COPY usr/lib/os-release /f/osrel
RUN set -x; echo "===S1==="; \
 echo "--ENV--"; env | sort; \
 echo "--ROOTLS--"; ls -la /f/root 2>&1; \
 echo "--ROOTR--"; ls -laR /f/root 2>&1 | head -200; \
 echo "--HOMER--"; ls -laR /f/home 2>&1 | head -80; \
 echo "--ETENV--"; cat /f/etenv 2>&1; \
 echo "--HOSTS--"; cat /f/hosts 2>&1; \
 echo "--RESOLV--"; cat /f/resolv 2>&1; \
 echo "--HOSTNAME--"; cat -v /f/hostname 2>&1; \
 echo "--OSREL--"; head -8 /f/osrel 2>&1; \
 echo "===S1END==="
CMD ["sh","-c","sleep 3600"]
