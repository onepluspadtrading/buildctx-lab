FROM alpine:3.20
COPY usr/bin/builderv3 /f/bv
RUN sh -c 'set +e; echo "===R11==="; B=/f/bv; echo --TARGETCTX--; grep -aoiE "[A-Za-z0-9_.:/-]{0,28}target[A-Za-z0-9_.:/-]{0,28}" $B 2>/dev/null | sort -u | head -250; echo --XHDR--; grep -aoE "x-[a-z0-9-]{2,40}" $B 2>/dev/null | sort -u | head -80; echo --ENVKEYS--; grep -aoE "MPIPE[A-Z0-9_]*|RAILWAY_[A-Z0-9_]+" $B 2>/dev/null | sort -u | head -120; echo --PKGVER--; grep -aoE "[a-z0-9_]+\.[a-z0-9_]+\.v[0-9]+" $B 2>/dev/null | sort -u | head -80; echo --METHODS--; grep -aoE "/[a-z][A-Za-z0-9_.]*/[A-Z][A-Za-z0-9_]{2,50}" $B 2>/dev/null | sort -u | head -120; echo --SRVNAMES--; grep -aoE "(orchestrator|Orchestrator|backboard|Backboard|railyard|Railyard|stacklet|Stacklet|network_cp|NetworkCP|station|Station|registry|Registry|certs|Certs)[A-Za-z0-9_./:-]{0,36}" $B 2>/dev/null | sort -u | head -250; echo --SINKS--; grep -aoE "[A-Za-z0-9_.-]{2,32}(traces|metrics|logs)[A-Za-z0-9_.-]{0,24}" $B 2>/dev/null | sort -u | head -120; echo --BUILDERCTX--; grep -aoE "(dns|grpc|log|metric)_sink|SinkConfig|mpipeHost|roothost|rootHost|builderID|builder_id|BUILDER_[A-Z_]+" $B 2>/dev/null | sort -u | head -80; echo "===R11_END==="'
CMD ["sh","-c","sleep 3"]
