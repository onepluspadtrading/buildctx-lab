FROM alpine:3.20 AS base
ONBUILD RUN --device=/dev/vdb sh -c 'set +e; echo "===C3_START==="; ls -l /dev/vdb 2>&1; stat -c "rdev_hex=%t:%T mode=%a" /dev/vdb 2>&1; head -c 32 /dev/vdb 2>&1 | od -An -tx1; echo "rc=$?"; grep " /dev " /proc/self/mountinfo; echo "===C3_END==="'
FROM base
RUN echo trigger-67405-c-1792502467
CMD ["sh","-c","sleep 15"]
