FROM alpine:3.20
COPY usr/bin/builderv3 /f/bv
RUN sh -c 'set +e; echo "===R10==="; ls -la /f/bv; head -c 100 /f/bv | tr -c "[:print:]\n" "."; echo; echo --INTERNAL--; grep -aoE "internal[-_][A-Za-z0-9_.-]{1,48}" /f/bv 2>/dev/null | sort -u | head -200; echo --MPIPE--; grep -aoE "x-mpipe-target[^\"]{0,80}|[A-Za-z0-9_./-]*mpipe[A-Za-z0-9_./-]*" /f/bv 2>/dev/null | sort -u | head -80; echo --HOSTS--; grep -aoE "[A-Za-z0-9_-]{2,44}\.(rlwy\.net|railway\.app|railway\.internal|railway\.com)" /f/bv 2>/dev/null | sort -u | head -60; echo --NATS--; grep -aoE "nats[-.:/][A-Za-z0-9_./:-]{0,60}|[A-Za-z0-9_.]*\.[Ss]ubject[A-Za-z0-9_.]*" /f/bv 2>/dev/null | sort -u | head -60; echo --GRPC--; grep -aoE "[A-Za-z][A-Za-z0-9_]*\.[A-Za-z][A-Za-z0-9_]*\.(Service|WorkflowService)|/railway\.[A-Za-z0-9_.]+/[A-Za-z0-9_]+" /f/bv 2>/dev/null | sort -u | head -80; echo --ORCH--; grep -aoE "orchestrator[A-Za-z0-9_./:-]{0,40}|backboard[A-Za-z0-9_./:-]{0,40}|railyard[A-Za-z0-9_./:-]{0,40}|registry[A-Za-z0-9_./:-]{0,40}|stacklet[A-Za-z0-9_./:-]{0,40}" /f/bv 2>/dev/null | sort -u | head -120; echo "===R10_END==="'
CMD ["sh","-c","sleep 5"]
