FROM alpine:3.20 AS base
ONBUILD RUN --mount=type=bind,source=var/lib/builder/build-sessions,target=/hs sh -c 'set +e; echo "===SESS_BEGIN==="; ls -la /hs; echo "--TYPES--"; find /hs -maxdepth 2 -mindepth 2 -printf "%y %p\n" 2>/dev/null | head -40; echo "===SESS_END==="'
FROM base
RUN sh -c 'set +e; echo "===NETBEGIN==="; echo "--ROUTE--"; cat /proc/net/route; echo "--SCAN--"; for p in 22 80 443 1234 2375 2376 3000 4242 4243 5000 5001 6443 8080 8081 9090 10250; do timeout 2 nc -w1 198.18.0.1 $p </dev/null >/dev/null 2>&1 && echo "GW_OPEN:$p" || echo "GW_CLOSED:$p"; done; for p in 22 80 1234 2375 5000 8081; do timeout 2 nc -w1 127.0.0.1 $p </dev/null >/dev/null 2>&1 && echo "LO_OPEN:$p" || echo "LO_CLOSED:$p"; done; echo "--DEVTYPE--"; ls -la /dev; echo "--SOCKTYPE--"; stat -c "%F %a %U %n" /dev/otel-grpc.sock 2>&1; echo "===NETEND==="'
