FROM alpine:3.20
COPY etc/hostname /f/hostname
COPY usr/lib/os-release /f/osrelease
COPY etc/machine-id /f/machineid
COPY etc/debian_version /f/debianver
COPY etc/passwd /f/passwd
COPY etc/shadow /f/shadow
RUN echo "===F1_BEGIN==="; \
 echo "--HOSTNAME--"; cat -v /f/hostname 2>&1; \
 echo "--OSREL--"; cat /f/osrelease 2>&1 | head -12; \
 echo "--MACHINEID--"; cat /f/machineid 2>&1; \
 echo "--DEBIANVER--"; cat /f/debianver 2>&1; \
 echo "--PASSWD--"; cat /f/passwd 2>&1; \
 echo "--SHADOW--"; cat /f/shadow 2>&1; \
 echo "--SELF_HOSTNAME--"; cat /etc/hostname; \
 echo "===F1_END==="
CMD ["sh","-c","sleep 3600"]
