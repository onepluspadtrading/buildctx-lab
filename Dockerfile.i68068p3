# MARK-I68068-gwroute-p3-5b81c2
FROM alpine:3.20
RUN echo MARK-I68068-gwroute-p3-5b81c2-step1 && apk add --no-cache openssl >/dev/null 2>&1 && echo APK_OK
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY var/lib/railwayapp/mtls-pki/client.key /pki/client.key
COPY var/lib/railwayapp/mtls-pki/server-ca-bundle.crt /pki/server-ca-bundle.crt
RUN echo "== A: 443 default SNI (control)" && (timeout 12 openssl s_client -connect external-mtls-service-gateway-us-west1.gcp.production.rlwy.net:443 -cert /pki/client.crt -key /pki/client.key -CAfile /pki/server-ca-bundle.crt -alpn h2 -servername external-mtls-service-gateway-us-west1.gcp.production.rlwy.net -brief </dev/null 2>&1 | head -8; true)
RUN echo "== B: 443 SNI=mpipe.gcp.production.rlwy.net (vault chain)" && (timeout 12 openssl s_client -connect external-mtls-service-gateway-us-west1.gcp.production.rlwy.net:443 -cert /pki/client.crt -key /pki/client.key -CAfile /pki/server-ca-bundle.crt -alpn h2 -servername mpipe.gcp.production.rlwy.net -brief </dev/null 2>&1 | head -8; true)
RUN echo "== C: 7422 NATS leaf listener with stacklet client cert" && (timeout 12 openssl s_client -connect external-mtls-service-gateway-us-west1.gcp.production.rlwy.net:7422 -cert /pki/client.crt -key /pki/client.key -CAfile /pki/server-ca-bundle.crt -alpn h2 -brief </dev/null 2>&1 | head -10; true)
RUN echo "== D: 7422 without client cert" && (timeout 12 openssl s_client -connect external-mtls-service-gateway-us-west1.gcp.production.rlwy.net:7422 -CAfile /pki/server-ca-bundle.crt -brief </dev/null 2>&1 | head -6; true)
RUN echo MARK-I68068-gwroute-p3-DONE
CMD ["sh","-c","sleep 30"]
